{
  "schema_version": "0.1.0",
  "cases": {
    "accredited-certification-with-as-of-date.json": {
      "schema": "assurance-record",
      "expected_errors": [
        {
          "instance_path": "/temporal_scope",
          "keyword": "additionalProperties",
          "additional_property": "as_of_date",
          "combinator_ancestry_contains": "oneOf",
          "schema_path_contains": "certificationTemporalScope"
        },
        {
          "instance_path": "/temporal_scope",
          "keyword": "required",
          "missing_property": "valid_from",
          "combinator_ancestry_contains": "oneOf"
        },
        {
          "instance_path": "/temporal_scope",
          "keyword": "required",
          "missing_property": "valid_until",
          "combinator_ancestry_contains": "oneOf"
        }
      ]
    },
