{
  "name": "openva",
  "version": "0.1.0",
  "description": "Local-first, read-only MCP server over the OpenVA public export contract. Reads static, digest-verifiable vendor assurance source metadata. Not advice; no catalog mutation; no GitHub writes.",
  "vendor": "Open Vendor Assurance",
  "license": "MIT",
  "homepage": "https://thedanieltan.github.io/open-vendor-assurance",
  "repository": "https://github.com/thedanieltan/open-vendor-assurance",
  "transport": "stdio",
  "command": "openva-mcp",
  "args": ["--snapshot", "${OPENVA_SNAPSHOT_DIR}"],
  "tools": [
    "search_vendors",
    "get_vendor",
    "list_vendor_sources",
    "get_source",
    "get_source_health",
    "get_vendor_changes",
    "match_inventory",
    "get_snapshot_metadata",
    "verify_snapshot"
  ],
  "capabilities": {
    "read_only": true,
    "requires_network": false,
    "requires_secrets": false
  }
}
