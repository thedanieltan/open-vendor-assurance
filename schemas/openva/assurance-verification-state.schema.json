{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/openva/assurance-verification-state.schema.json",
  "title": "OpenVA Assurance Verification State",
  "description": "Structural output contract for non-advisory assurance verification-state results. This is not lifecycle projection and not a runtime evaluator.",
  "type": "object",
  "required": [
    "schema_version",
    "assurance_id",
    "vendor_id",
    "effective_at",
    "knowledge_cutoff",
    "policy",
    "input_digest",
    "value",
    "determination",
    "reason_codes",
    "caused_by",
    "advisory_boundary"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assurance_id": { "$ref": "#/$defs/openvaSlug" },
    "vendor_id": { "$ref": "#/$defs/openvaSlug" },
    "effective_at": { "type": "string", "format": "date-time" },
    "knowledge_cutoff": { "type": "string", "format": "date-time" },
    "policy": { "$ref": "#/$defs/policyRef" },
    "input_digest": { "$ref": "#/$defs/sha256Digest" },
    "value": {
      "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/verificationState"
    },
    "determination": {
      "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/determination"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/verificationStateReasonCode"
      }
    },
    "caused_by": { "$ref": "#/$defs/causedBy" },
    "advisory_boundary": { "const": "non_advisory" }
  },
  "additionalProperties": false,
  "$defs": {
    "openvaSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      },
      "additionalProperties": false
    },
    "causedBy": {
      "type": "object",
      "required": [
        "assurance_ids",
        "assurance_observation_ids",
        "source_observation_ids"
      ],
      "properties": {
        "assurance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "assurance_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "source_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        }
      },
      "additionalProperties": false
    }
  }
}
