{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/openva/assurance-intelligence-publication-policy.schema.json",
  "title": "OpenVA Assurance Intelligence Publication Policy",
  "description": "Policy controlling public-safe publication of materialized assurance intelligence projections.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "allowed_projection_profiles",
    "allowed_axes",
    "public_entry_fields",
    "public_axis_fields",
    "expose_reason_codes",
    "excluded_internal_fields",
    "malformed_input_behavior",
    "unsupported_profile_behavior",
    "advisory_boundary"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "policy_id": { "const": "openva.assurance-intelligence-publication.default" },
    "policy_version": { "const": "0.1.0" },
    "allowed_projection_profiles": {
      "type": "array",
      "prefixItems": [
        { "const": "openva.assurance-intelligence.v1" }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "allowed_axes": {
      "type": "array",
      "prefixItems": [
        { "const": "instrument_state" },
        { "const": "supersession_state" },
        { "const": "verification_state" },
        { "const": "verification_freshness" },
        { "const": "evidence_set_state" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "public_entry_fields": {
      "type": "array",
      "items": {
        "enum": [
          "assurance_id",
          "vendor_id",
          "assurance_label",
          "assurance_class",
          "framework_id",
          "framework_display_name",
          "projection_profile",
          "effective_at",
          "knowledge_cutoff",
          "next_reevaluation_at",
          "axes"
        ]
      },
      "uniqueItems": true,
      "minItems": 8
    },
    "public_axis_fields": {
      "type": "array",
      "items": { "enum": ["value", "reason_code"] },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 2
    },
    "expose_reason_codes": { "type": "boolean" },
    "excluded_internal_fields": {
      "type": "array",
      "items": {
        "enum": [
          "input_digest",
          "projected_at",
          "policy",
          "policies",
          "policy_digest",
          "projection_ref",
          "caused_by",
          "assurance_observation_ids",
          "source_observation_ids",
          "raw_observations",
          "internal_manifests",
          "runtime_metadata",
          "filesystem_paths"
        ]
      },
      "uniqueItems": true,
      "minItems": 8
    },
    "malformed_input_behavior": { "const": "fail_closed" },
    "unsupported_profile_behavior": { "const": "fail_closed" },
    "advisory_boundary": { "const": "non_advisory" }
  },
  "additionalProperties": false
}
