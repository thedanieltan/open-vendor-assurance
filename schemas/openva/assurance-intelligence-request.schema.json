{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/openva/assurance-intelligence-request.schema.json",
  "title": "OpenVA Assurance Intelligence Projection Request",
  "description": "Structural request contract for pure five-axis assurance intelligence projection.",
  "type": "object",
  "required": [
    "schema_version",
    "assurance_id",
    "effective_at",
    "knowledge_cutoff",
    "projection_profile",
    "policies"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assurance_id": { "$ref": "#/$defs/openvaSlug" },
    "effective_at": { "type": "string", "format": "date-time" },
    "knowledge_cutoff": { "type": "string", "format": "date-time" },
    "projection_profile": { "const": "openva.assurance-intelligence.v1" },
    "policies": { "$ref": "#/$defs/policies" }
  },
  "additionalProperties": false,
  "$defs": {
    "openvaSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "required": [
        "lifecycle",
        "verification",
        "verification_freshness",
        "evidence_set"
      ],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/policyRef" },
        "verification": { "$ref": "#/$defs/policyRef" },
        "verification_freshness": { "$ref": "#/$defs/policyRef" },
        "evidence_set": { "$ref": "#/$defs/policyRef" }
      },
      "additionalProperties": false
    }
  }
}
