{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/openva/assurance-verification-freshness.schema.json",
  "title": "OpenVA Assurance Verification Freshness",
  "description": "Structural output contract for non-advisory verification-freshness results derived from the decisive observation basis.",
  "type": "object",
  "required": [
    "schema_version",
    "assurance_id",
    "vendor_id",
    "effective_at",
    "knowledge_cutoff",
    "policy",
    "input_digest",
    "value",
    "determination",
    "reason_codes",
    "basis_observed_at",
    "age_seconds",
    "next_reevaluation_at",
    "caused_by",
    "advisory_boundary"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assurance_id": { "$ref": "#/$defs/openvaSlug" },
    "vendor_id": { "$ref": "#/$defs/openvaSlug" },
    "effective_at": { "type": "string", "format": "date-time" },
    "knowledge_cutoff": { "type": "string", "format": "date-time" },
    "policy": { "$ref": "#/$defs/policyRef" },
    "input_digest": { "$ref": "#/$defs/sha256Digest" },
    "value": {
      "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/verificationFreshnessState"
    },
    "determination": {
      "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/determination"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/verificationFreshnessReasonCode"
      }
    },
    "basis_observed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "age_seconds": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "next_reevaluation_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "caused_by": { "$ref": "#/$defs/causedBy" },
    "advisory_boundary": { "const": "non_advisory" }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "value": { "const": "no_basis" },
        "reason_codes": {
          "const": ["no_decisive_verification_observation"]
        },
        "basis_observed_at": { "const": null },
        "age_seconds": { "const": null },
        "next_reevaluation_at": { "const": null },
        "caused_by": {
          "properties": {
            "assurance_observation_ids": { "maxItems": 0 },
            "source_observation_ids": { "maxItems": 0 }
          }
        }
      }
    },
    {
      "properties": {
        "value": { "const": "current" },
        "reason_codes": {
          "const": ["decisive_basis_within_current_threshold"]
        },
        "basis_observed_at": { "type": "string", "format": "date-time" },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "next_reevaluation_at": { "type": "string", "format": "date-time" }
      }
    },
    {
      "properties": {
        "value": { "const": "aging" },
        "reason_codes": {
          "const": ["decisive_basis_within_aging_threshold"]
        },
        "basis_observed_at": { "type": "string", "format": "date-time" },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "next_reevaluation_at": { "type": "string", "format": "date-time" }
      }
    },
    {
      "properties": {
        "value": { "const": "stale" },
        "reason_codes": {
          "const": ["decisive_basis_exceeds_stale_threshold"]
        },
        "basis_observed_at": { "type": "string", "format": "date-time" },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "next_reevaluation_at": { "const": null }
      }
    }
  ],
  "$defs": {
    "openvaSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      },
      "additionalProperties": false
    },
    "causedBy": {
      "type": "object",
      "required": [
        "assurance_ids",
        "assurance_observation_ids",
        "source_observation_ids"
      ],
      "properties": {
        "assurance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "assurance_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "source_observation_ids": {
          "type": "array",
          "maxItems": 0,
          "items": { "$ref": "#/$defs/openvaSlug" }
        }
      },
      "additionalProperties": false
    }
  }
}
