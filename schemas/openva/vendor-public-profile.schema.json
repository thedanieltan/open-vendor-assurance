{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/vendor-public-profile.schema.json",
  "title": "OpenVA Vendor Public Profile",
  "type": "object",
  "required": [
    "schema_version",
    "vendor_id",
    "display_name",
    "legal_name",
    "headquarters_country",
    "official_domains",
    "source_policy",
    "catalog_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "vendor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "display_aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160 },
      "uniqueItems": true,
      "default": [],
      "description": "Former or alternate public names for the vendor (renames, prior brands, common abbreviations)."
    },
    "legal_name": { "type": ["string", "null"], "maxLength": 240 },
    "headquarters_country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "regions_served": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
      "uniqueItems": true,
      "default": []
    },
    "entity_family": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "entity_surface": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,39}$" },
    "related_vendor_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
      "uniqueItems": true,
      "default": []
    },
    "observed_entity_mention_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
      "uniqueItems": true,
      "default": []
    },
    "source_authority_language": { "type": ["string", "null"], "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$" },
    "official_domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "previous_domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
      "uniqueItems": true,
      "default": [],
      "description": "Domains previously official for this vendor; preserves identity continuity across renames and domain migrations."
    },
    "public_entrypoints": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true,
      "default": []
    },
    "vendor_categories": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "source_policy": {
      "type": "object",
      "required": ["public_sources_only", "gated_materials_excluded", "raw_documents_mirrored_by_default"],
      "properties": {
        "public_sources_only": { "const": true },
        "gated_materials_excluded": { "const": true },
        "raw_documents_mirrored_by_default": { "const": false }
      },
      "additionalProperties": false
    },
    "catalog_status": { "enum": ["active", "watchlist", "deprecated", "quarantined", "stub", "canonical", "machine_provisional"] },
    "status": {
      "enum": ["active", "watchlist", "deprecated", "quarantined", "stub", "canonical", "machine_provisional"],
      "deprecated": true,
      "description": "Deprecated v0.1.x compatibility alias for catalog_status. Remove in v0.2.0 or openva-export-pack.v2, whichever ships first."
    },
    "machine_generated": {
      "type": "boolean",
      "description": "WP36: true if this vendor was materialized by autonomous growth rather than human/reviewed contribution."
    },
    "machine_decision_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "WP36: id of the machine decision record that materialized this vendor (maintenance/machine-decisions/)."
    },
    "reversal": {
      "type": ["object", "null"],
      "description": "WP36: how to reverse this machine-created vendor through a PR (quarantine or removal). Required on machine-generated records by the release-gate reversibility check.",
      "properties": {
        "reversal_decision_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
        "method": { "type": ["string", "null"], "enum": ["quarantine", "remove", null] },
        "reference": { "type": ["string", "null"], "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "notes": { "type": ["string", "null"], "maxLength": 1000 }
  },
  "additionalProperties": false
}
