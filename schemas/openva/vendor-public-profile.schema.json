{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/vendor-public-profile.schema.json",
  "title": "OpenVA Vendor Public Profile",
  "type": "object",
  "required": [
    "schema_version",
    "vendor_id",
    "display_name",
    "legal_name",
    "headquarters_country",
    "official_domains",
    "source_policy",
    "catalog_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "vendor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "legal_name": { "type": ["string", "null"], "maxLength": 240 },
    "headquarters_country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "regions_served": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
      "uniqueItems": true,
      "default": []
    },
    "identity_status": {
      "enum": [
        "brand_only",
        "entity_unresolved",
        "entity_verified",
        "contracting_entity_verified"
      ],
      "description": "Public evidence maturity for vendor identity. This is factual catalog posture, not an assurance conclusion."
    },
    "assurance_profile_status": {
      "enum": [
        "brand_source_stub",
        "partial_public_evidence",
        "entity_verified_public_evidence",
        "contracting_source_verified_public_evidence"
      ],
      "description": "Completeness level of the public evidence bundle available for downstream assessment."
    },
    "entity_family": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "entity_surface": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,39}$" },
    "related_vendor_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
      "uniqueItems": true,
      "default": []
    },
    "observed_entity_mention_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
      "uniqueItems": true,
      "default": []
    },
    "source_authority_language": { "type": ["string", "null"], "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$" },
    "official_domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "public_entrypoints": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true,
      "default": []
    },
    "vendor_categories": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "source_policy": {
      "type": "object",
      "required": ["public_sources_only", "gated_materials_excluded", "raw_documents_mirrored_by_default"],
      "properties": {
        "public_sources_only": { "const": true },
        "gated_materials_excluded": { "const": true },
        "raw_documents_mirrored_by_default": { "const": false }
      },
      "additionalProperties": false
    },
    "catalog_status": { "enum": ["active", "watchlist", "deprecated", "quarantined", "stub", "canonical"] },
    "status": {
      "enum": ["active", "watchlist", "deprecated", "quarantined", "stub", "canonical"],
      "deprecated": true,
      "description": "Deprecated v0.1.x compatibility alias for catalog_status. Remove in v0.2.0 or openva-export-pack.v2, whichever ships first."
    },
    "notes": { "type": ["string", "null"], "maxLength": 1000 }
  },
  "additionalProperties": false
}