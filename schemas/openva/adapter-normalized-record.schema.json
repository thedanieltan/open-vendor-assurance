{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/adapter-normalized-record.schema.json",
  "title": "OpenVA Adapter Normalized Record",
  "type": "object",
  "required": ["record_class", "canonical", "catalog_tier", "review_state", "advisory_boundary"],
  "properties": {
    "record_class": {
      "enum": [
        "vendor",
        "canonical",
        "candidate",
        "unavailable",
        "observation",
        "artifact",
        "change",
        "legal_entity",
        "coverage",
        "inventory_match"
      ]
    },
    "canonical": { "type": "boolean" },
    "catalog_tier": {
      "enum": [
        "discovery",
        "observation",
        "machine_validated",
        "human_reviewed"
      ]
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "auto_observed",
        "auto_validated",
        "human_review_required",
        "human_reviewed",
        "deprecated",
        "blocked_by_scope"
      ]
    },
    "advisory_boundary": { "const": "non_advisory" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "record_class": { "const": "canonical" } },
        "required": ["record_class"]
      },
      "then": {
        "properties": { "canonical": { "const": true } }
      }
    },
    {
      "if": {
        "properties": {
          "record_class": {
            "enum": ["vendor", "candidate", "unavailable", "observation", "artifact", "change", "legal_entity", "coverage", "inventory_match"]
          }
        },
        "required": ["record_class"]
      },
      "then": {
        "properties": { "canonical": { "const": false } }
      }
    }
  ]
}
