{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/source-reference.schema.json",
  "title": "OpenVA Source Reference",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "vendor_id",
    "source_type",
    "title_native",
    "source_url",
    "source_language",
    "source_authority_class",
    "access_class",
    "rights_class",
    "provenance",
    "not_advice"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "vendor_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "source_type": {
      "enum": [
        "dpa",
        "subprocessors_list",
        "privacy_notice",
        "trust_center",
        "security_page",
        "compliance_page",
        "certification_reference",
        "terms_of_service",
        "kyc_statement",
        "aml_statement",
        "ai_terms",
        "government_request_policy",
        "transparency_report",
        "status_page",
        "other_public_source"
      ]
    },
    "title_native": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "title_en": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "coverage_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "coverage_type",
          "evidence"
        ],
        "properties": {
          "role": {
            "enum": [
              "dpa",
              "subprocessors_list",
              "privacy_notice",
              "trust_center",
              "security_page",
              "compliance_page",
              "certification_reference",
              "terms_of_service",
              "kyc_statement",
              "aml_statement",
              "ai_terms",
              "government_request_policy",
              "transparency_report",
              "status_page",
              "other_public_source"
            ]
          },
          "coverage_type": {
            "enum": [
              "contains",
              "links_to",
              "references"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "target_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "target_source_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$"
    },
    "effective_or_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_authority_class": {
      "enum": [
        "vendor_published",
        "public_registry",
        "public_authority",
        "court_or_regulatory_filing",
        "vendor_legal_terms"
      ]
    },
    "access_class": {
      "enum": [
        "public_web",
        "public_pdf",
        "public_doc_portal",
        "public_landing_gated_docs",
        "excluded_non_public"
      ]
    },
    "rights_class": {
      "enum": [
        "metadata_only",
        "public_link_only",
        "snapshot_allowed",
        "snapshot_forbidden",
        "gated_excluded"
      ]
    },
    "verified_scope": {
      "description": "Tier A: how far content verification reached. landing_page_only means only the public landing page was content-verified; its gated child documents were not (and must not be) inspected.",
      "enum": [
        "full_content",
        "landing_page_only"
      ]
    },
    "gated_child_content_observed": {
      "description": "Tier A doctrine guarantee: OpenVA never observes gated child documents, so this may only ever be false. Any true is a schema violation.",
      "const": false
    },
    "catalog_tier": {
      "enum": [
        "machine_validated",
        "human_reviewed"
      ]
    },
    "review_state": {
      "enum": [
        "proposed",
        "validated",
        "auto_validated",
        "human_reviewed",
        "human_review_required",
        "quarantined",
        "superseded"
      ]
    },
    "quarantine": {
      "type": "object",
      "description": "Set when a source is autonomously quarantined (e.g. persistently not-found with no safe replacement). Reversible: reason, actor, timestamp, the linked quarantine decision, and a reversal reference. Operational metadata only; not a vendor risk, compliance, suitability, or approval signal.",
      "required": [
        "reason",
        "quarantined_by",
        "quarantined_at",
        "decision_id",
        "reversal"
      ],
      "properties": {
        "reason": {
          "enum": [
            "persistent_not_found",
            "persistent_gone"
          ]
        },
        "quarantined_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quarantined_at": {
          "type": "string",
          "format": "date-time"
        },
        "prior_review_state": {
          "type": [
            "string",
            "null"
          ],
          "description": "The review_state before quarantine, captured so a Level-5 rollback restores it faithfully."
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "reversal": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "const": "revert_quarantine"
            },
            "reference": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            },
            "reversal_decision_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "advisory_boundary": {
      "const": "non_advisory"
    },
    "summary_native": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1200
    },
    "summary_en": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1200
    },
    "canonical_confidence": {
      "type": "object",
      "description": "Confidence that this URL is the vendor's canonical location for this source type. Not a vendor risk or compliance signal.",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "canonical",
            "likely_canonical",
            "mirror",
            "redirected_entrypoint",
            "ambiguous"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "assessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "authority": {
          "type": [
            "object",
            "null"
          ],
          "description": "Tier A: durable, structured authority provenance carried from the candidate. CNAME/TLS are corroboration only and never strong on their own. The free-text basis above is supplemental; machines read this object, not the prose.",
          "required": [
            "class",
            "method",
            "target_url",
            "observed_at"
          ],
          "properties": {
            "class": {
              "enum": [
                "strong",
                "corroborating",
                "unproven"
              ]
            },
            "method": {
              "enum": [
                "same_official_domain",
                "official_domain_link",
                "official_domain_redirect",
                "official_vendor_manifest",
                "manual_exception",
                "cname_corroboration",
                "tls_corroboration"
              ]
            },
            "source_url": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2048
            },
            "target_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "method": {
                    "enum": [
                      "cname_corroboration",
                      "tls_corroboration"
                    ]
                  }
                },
                "required": [
                  "method"
                ]
              },
              "then": {
                "properties": {
                  "class": {
                    "enum": [
                      "corroborating",
                      "unproven"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "class": {
                    "const": "strong"
                  }
                },
                "required": [
                  "class"
                ]
              },
              "then": {
                "properties": {
                  "method": {
                    "enum": [
                      "same_official_domain",
                      "official_domain_link",
                      "official_domain_redirect",
                      "official_vendor_manifest",
                      "manual_exception"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "description": "How the source can be retrieved, including machine-readable hints for agent consumers.",
      "required": [
        "method",
        "machine_readable"
      ],
      "properties": {
        "method": {
          "enum": [
            "html_page",
            "pdf_document",
            "rss_feed",
            "atom_feed",
            "json_api",
            "llms_txt",
            "mcp_server",
            "sitemap",
            "csv_download",
            "other"
          ]
        },
        "machine_readable": {
          "type": "boolean"
        },
        "hints": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "feed_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "api_endpoint": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "llms_txt_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "content_selector": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source_health": {
      "type": "object",
      "description": "Curated, slowly-changing registry health summary. Per-run measurement stays in observation records and source-health reports.",
      "required": [
        "status",
        "as_of"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "stale",
            "moved",
            "gated",
            "broken",
            "retired",
            "unknown"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "change_detection": {
      "type": "object",
      "description": "Reviewed baseline that future observations are compared against for material-change detection.",
      "required": [
        "baseline_observed_at"
      ],
      "properties": {
        "baseline_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "baseline_observation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "baseline_raw_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "baseline_normalized_text_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "publisher",
        "collected_at",
        "observer",
        "confidence"
      ],
      "properties": {
        "publisher": {
          "enum": [
            "vendor",
            "standards_body",
            "regulator",
            "other_public_authority"
          ]
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "observer": {
          "enum": [
            "human",
            "agent",
            "hybrid"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "not_advice": {
      "const": true
    },
    "publisher_attribution": {
      "type": "object",
      "description": "Who publishes the source and how that publisher relates to the selected product. This is source provenance only, not a legal, compliance, procurement, security, or vendor-risk conclusion.",
      "required": [
        "publisher_name",
        "publisher_domain",
        "relationship"
      ],
      "properties": {
        "publisher_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "publisher_vendor_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "publisher_domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$",
          "minLength": 3,
          "maxLength": 253
        },
        "relationship": {
          "enum": [
            "self",
            "parent",
            "affiliate",
            "regional_entity",
            "authorized_host",
            "public_authority"
          ]
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "description": "Why this source is applicable to the product represented by vendor_id. Required by the changed-record catalog guard for cross-domain canonical sources.",
      "required": [
        "status",
        "coverage_basis",
        "covered_products",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "not_required",
            "unresolved"
          ]
        },
        "coverage_basis": {
          "enum": [
            "same_product_domain",
            "explicit_product_name",
            "explicit_product_domain",
            "defined_services_inclusion",
            "incorporated_agreement",
            "official_link",
            "official_redirect",
            "manual_exception"
          ]
        },
        "covered_products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "evidence_url",
            "statement",
            "assessed_at"
          ],
          "properties": {
            "evidence_url": {
              "type": "string",
              "format": "uri"
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "assessed_at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_authority_class": {
            "enum": [
              "public_registry",
              "public_authority",
              "court_or_regulatory_filing"
            ]
          }
        },
        "required": [
          "source_authority_class"
        ]
      },
      "then": {
        "required": [
          "entity_id"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
