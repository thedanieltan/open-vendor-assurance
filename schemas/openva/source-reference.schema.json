{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/source-reference.schema.json",
  "title": "OpenVA Source Reference",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "vendor_id",
    "source_type",
    "title_native",
    "source_url",
    "source_language",
    "source_authority_class",
    "access_class",
    "rights_class",
    "provenance",
    "not_advice"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "vendor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "entity_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "source_type": {
      "enum": [
        "dpa",
        "subprocessors_list",
        "privacy_notice",
        "trust_center",
        "security_page",
        "compliance_page",
        "certification_reference",
        "terms_of_service",
        "kyc_statement",
        "aml_statement",
        "ai_terms",
        "government_request_policy",
        "transparency_report",
        "other_public_source"
      ]
    },
    "title_native": { "type": "string", "minLength": 1, "maxLength": 300 },
    "title_en": { "type": ["string", "null"], "maxLength": 300 },
    "source_url": { "type": "string", "format": "uri" },
    "coverage_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "coverage_type", "evidence"],
        "properties": {
          "role": {
            "enum": [
              "dpa",
              "subprocessors_list",
              "privacy_notice",
              "trust_center",
              "security_page",
              "compliance_page",
              "certification_reference",
              "terms_of_service",
              "kyc_statement",
              "aml_statement",
              "ai_terms",
              "government_request_policy",
              "transparency_report",
              "other_public_source"
            ]
          },
          "coverage_type": {
            "enum": ["contains", "links_to", "references"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "target_url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "target_source_id": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$" },
    "effective_or_published_at": { "type": ["string", "null"], "format": "date" },
    "source_authority_class": {
      "enum": [
        "vendor_published",
        "public_registry",
        "public_authority",
        "court_or_regulatory_filing",
        "vendor_legal_terms"
      ]
    },
    "access_class": { "enum": ["public_web", "public_pdf", "public_doc_portal", "public_landing_gated_docs", "excluded_non_public"] },
    "rights_class": { "enum": ["metadata_only", "public_link_only", "snapshot_allowed", "snapshot_forbidden", "gated_excluded"] },
    "catalog_tier": { "enum": ["machine_validated", "human_reviewed"] },
    "review_state": { "enum": ["proposed", "validated", "auto_validated", "human_reviewed", "human_review_required", "quarantined", "superseded"] },
    "advisory_boundary": { "const": "non_advisory" },
    "summary_native": { "type": ["string", "null"], "maxLength": 1200 },
    "summary_en": { "type": ["string", "null"], "maxLength": 1200 },
    "canonical_confidence": {
      "type": "object",
      "description": "Confidence that this URL is the vendor's canonical location for this source type. Not a vendor risk or compliance signal.",
      "required": ["class"],
      "properties": {
        "class": {
          "enum": ["canonical", "likely_canonical", "mirror", "redirected_entrypoint", "ambiguous"]
        },
        "basis": { "type": ["string", "null"], "maxLength": 500 },
        "assessed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "description": "How the source can be retrieved, including machine-readable hints for agent consumers.",
      "required": ["method", "machine_readable"],
      "properties": {
        "method": {
          "enum": [
            "html_page",
            "pdf_document",
            "rss_feed",
            "atom_feed",
            "json_api",
            "llms_txt",
            "mcp_server",
            "sitemap",
            "csv_download",
            "other"
          ]
        },
        "machine_readable": { "type": "boolean" },
        "hints": {
          "type": ["object", "null"],
          "properties": {
            "feed_url": { "type": ["string", "null"], "format": "uri" },
            "api_endpoint": { "type": ["string", "null"], "format": "uri" },
            "llms_txt_url": { "type": ["string", "null"], "format": "uri" },
            "content_selector": { "type": ["string", "null"], "maxLength": 200 },
            "notes": { "type": ["string", "null"], "maxLength": 500 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source_health": {
      "type": "object",
      "description": "Curated, slowly-changing registry health summary. Per-run measurement stays in observation records and source-health reports.",
      "required": ["status", "as_of"],
      "properties": {
        "status": {
          "enum": ["ok", "stale", "moved", "gated", "broken", "retired", "unknown"]
        },
        "as_of": { "type": "string", "format": "date-time" },
        "basis": { "type": ["string", "null"], "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "change_detection": {
      "type": "object",
      "description": "Reviewed baseline that future observations are compared against for material-change detection.",
      "required": ["baseline_observed_at"],
      "properties": {
        "baseline_observed_at": { "type": "string", "format": "date-time" },
        "baseline_observation_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
        "baseline_raw_sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$" },
        "baseline_normalized_text_sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["publisher", "collected_at", "observer", "confidence"],
      "properties": {
        "publisher": { "enum": ["vendor", "standards_body", "regulator", "other_public_authority"] },
        "collected_at": { "type": "string", "format": "date-time" },
        "observer": { "enum": ["human", "agent", "hybrid"] },
        "confidence": { "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    },
    "not_advice": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_authority_class": {
            "enum": ["public_registry", "public_authority", "court_or_regulatory_filing"]
          }
        },
        "required": ["source_authority_class"]
      },
      "then": { "required": ["entity_id"], "properties": { "entity_id": { "type": "string" } } }
    }
  ],
  "additionalProperties": false
}
