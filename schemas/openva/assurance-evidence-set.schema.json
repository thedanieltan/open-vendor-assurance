{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/openva/assurance-evidence-set.schema.json",
  "title": "OpenVA Assurance Evidence Set State",
  "description": "Structural output contract for non-advisory evidence-set completeness and coherence results.",
  "type": "object",
  "required": [
    "schema_version",
    "assurance_id",
    "vendor_id",
    "effective_at",
    "knowledge_cutoff",
    "policy",
    "input_digest",
    "value",
    "determination",
    "reason_codes",
    "required_dimensions",
    "satisfied_dimensions",
    "missing_dimensions",
    "conflicted_dimensions",
    "caused_by",
    "advisory_boundary"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assurance_id": { "$ref": "#/$defs/openvaSlug" },
    "vendor_id": { "$ref": "#/$defs/openvaSlug" },
    "effective_at": { "type": "string", "format": "date-time" },
    "knowledge_cutoff": { "type": "string", "format": "date-time" },
    "policy": { "$ref": "#/$defs/policyRef" },
    "input_digest": { "$ref": "#/$defs/sha256Digest" },
    "value": {
      "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/evidenceSetState"
    },
    "determination": {
      "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/determination"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/evidenceSetReasonCode"
      }
    },
    "required_dimensions": { "$ref": "#/$defs/dimensionArray" },
    "satisfied_dimensions": { "$ref": "#/$defs/dimensionArray" },
    "missing_dimensions": { "$ref": "#/$defs/dimensionArray" },
    "conflicted_dimensions": { "$ref": "#/$defs/dimensionArray" },
    "caused_by": { "$ref": "#/$defs/causedBy" },
    "advisory_boundary": { "const": "non_advisory" }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "value": { "const": "no_evidence" },
        "reason_codes": { "const": ["no_admitted_evidence"] },
        "satisfied_dimensions": { "maxItems": 0 },
        "conflicted_dimensions": { "maxItems": 0 },
        "caused_by": {
          "properties": {
            "assurance_observation_ids": { "maxItems": 0 },
            "source_observation_ids": { "maxItems": 0 }
          }
        }
      }
    },
    {
      "properties": {
        "value": { "const": "incomplete" },
        "reason_codes": { "const": ["required_evidence_missing"] },
        "conflicted_dimensions": { "maxItems": 0 }
      }
    },
    {
      "properties": {
        "value": { "const": "complete" },
        "reason_codes": { "const": ["required_evidence_complete"] },
        "missing_dimensions": { "maxItems": 0 },
        "conflicted_dimensions": { "maxItems": 0 }
      }
    },
    {
      "properties": {
        "value": { "const": "conflicted" },
        "reason_codes": { "const": ["evidence_conflict_detected"] }
      }
    }
  ],
  "$defs": {
    "openvaSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      },
      "additionalProperties": false
    },
    "dimensionArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "vocabularies/assurance-intelligence-v1.schema.json#/$defs/evidenceDimension"
      }
    },
    "causedBy": {
      "type": "object",
      "required": [
        "assurance_ids",
        "assurance_observation_ids",
        "source_observation_ids"
      ],
      "properties": {
        "assurance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "assurance_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "source_observation_ids": {
          "type": "array",
          "maxItems": 0,
          "items": { "$ref": "#/$defs/openvaSlug" }
        }
      },
      "additionalProperties": false
    }
  }
}
