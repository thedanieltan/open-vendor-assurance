{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/observation.schema.json",
  "title": "OpenVA Source Observation",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "vendor_id",
    "source_id",
    "observed_at",
    "result",
    "access_class",
    "hashes",
    "storage",
    "not_advice"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "observation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "vendor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "artifact_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "result": {
      "enum": [
        "ok",
        "not_modified",
        "moved",
        "access_changed",
        "bot_protected",
        "size_limited",
        "fetch_failed",
        "quarantined",
        "reachable",
        "unreachable",
        "redirect_changed",
        "content_changed",
        "auth_required"
      ]
    },
    "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "final_url": { "type": ["string", "null"], "format": "uri" },
    "redirect_chain": {
      "type": ["array", "null"],
      "items": { "type": "string", "format": "uri" },
      "maxItems": 20,
      "description": "Ordered intermediate URLs observed between source_url and final_url."
    },
    "material_change": {
      "type": ["boolean", "null"],
      "description": "Whether this observation's content hash differs from the source's change-detection baseline. Null means not evaluated."
    },
    "previous_observation_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Prior observation for the same source, forming a traversable history chain."
    },
    "retrieval_method": {
      "anyOf": [
        { "enum": ["html_page", "pdf_document", "rss_feed", "atom_feed", "json_api", "llms_txt", "mcp_server", "sitemap", "csv_download", "other"] },
        { "type": "null" }
      ],
      "description": "How the source was retrieved for this observation; aligns with the source-record retrieval.method vocabulary."
    },
    "change_class": {
      "anyOf": [
        { "enum": ["none", "non_material", "material_possible", "material_confirmed", "access_changed", "redirect_changed"] },
        { "type": "null" }
      ],
      "description": "Change signal for this observation relative to the previous observation and the curated change-detection baseline. Null means not evaluated."
    },
    "source_health": {
      "type": ["object", "null"],
      "required": ["status"],
      "properties": {
        "status": { "enum": ["reachable", "unreachable", "gated", "bot_protected", "redirected", "quarantined"] }
      },
      "additionalProperties": false,
      "description": "Reachability and access posture only. Content variation is a change signal (change_class), never a health status."
    },
    "review_signal": {
      "type": ["object", "null"],
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "maxLength": 300 }
      },
      "additionalProperties": false,
      "description": "Whether a maintainer should review this observation, and why."
    },
    "access_class": { "enum": ["public_web", "public_pdf", "public_doc_portal", "public_landing_gated_docs", "excluded_non_public"] },
    "catalog_tier": { "enum": ["observation"] },
    "review_state": { "enum": ["auto_observed"] },
    "hashes": {
      "type": "object",
      "required": ["raw_sha256", "normalized_text_sha256"],
      "properties": {
        "raw_sha256": { "type": "string", "pattern": "^(sha256:[a-fA-F0-9]{64}|sha256:TBD)$" },
        "normalized_text_sha256": { "type": "string", "pattern": "^(sha256:[a-fA-F0-9]{64}|sha256:TBD)$" },
        "etag": { "type": ["string", "null"] },
        "last_modified": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["raw_document_stored", "extracted_text_stored", "screenshot_stored"],
      "properties": {
        "raw_document_stored": { "const": false },
        "extracted_text_stored": { "type": "boolean" },
        "screenshot_stored": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "not_advice": { "const": true },
    "notes": { "type": ["string", "null"], "maxLength": 1000 }
  },
  "additionalProperties": false
}
