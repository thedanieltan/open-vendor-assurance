{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openva.dev/schemas/openva/assurance-record.schema.json",
  "title": "OpenVA Assurance Record",
  "description": "Immutable descriptive data about one public-source-backed assurance instrument or vendor assertion. Operational metadata only; not legal, compliance, procurement, security, KYC, AML, audit, or vendor-risk advice.",
  "type": "object",
  "required": [
    "schema_version",
    "assurance_id",
    "vendor_id",
    "assurance_class",
    "framework",
    "subject",
    "temporal_scope",
    "evidence",
    "advisory_boundary"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "assurance_id": { "$ref": "#/$defs/openvaSlug" },
    "vendor_id": { "$ref": "#/$defs/openvaSlug" },
    "assurance_class": { "$ref": "vocabularies/assurance-v1.schema.json#/$defs/assuranceClass" },
    "framework": { "$ref": "#/$defs/framework" },
    "subject": { "$ref": "#/$defs/subject" },
    "issuer": { "$ref": "#/$defs/issuer" },
    "identifiers": { "$ref": "#/$defs/identifiers" },
    "temporal_scope": { "type": "object" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "supersedes_assurance_id": {
      "anyOf": [
        { "$ref": "#/$defs/openvaSlug" },
        { "type": "null" }
      ]
    },
    "conditions": { "$ref": "#/$defs/conditions" },
    "advisory_boundary": { "const": "non_advisory" }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "accreditedCertificationAssuranceRecord",
      "required": ["issuer", "identifiers", "temporal_scope"],
      "properties": {
        "assurance_class": {
          "$ref": "vocabularies/assurance-v1.schema.json#/$defs/accreditedCertificationClass"
        },
        "identifiers": { "$ref": "#/$defs/accreditedCertificationIdentifiers" },
        "temporal_scope": { "$ref": "#/$defs/certificationTemporalScope" }
      },
      "not": { "required": ["conditions"] }
    },
    {
      "title": "attestationReportAssuranceRecord",
      "required": ["issuer", "temporal_scope"],
      "properties": {
        "assurance_class": {
          "$ref": "vocabularies/assurance-v1.schema.json#/$defs/attestationReportClass"
        },
        "temporal_scope": { "$ref": "#/$defs/attestationTemporalScope" }
      },
      "not": { "required": ["conditions"] }
    },
    {
      "title": "regulatoryAssertionAssuranceRecord",
      "required": ["temporal_scope"],
      "properties": {
        "assurance_class": {
          "$ref": "vocabularies/assurance-v1.schema.json#/$defs/regulatoryAssertionClass"
        },
        "temporal_scope": { "$ref": "#/$defs/regulatoryAssertionTemporalScope" }
      },
      "not": { "required": ["conditions"] }
    },
    {
      "title": "contractualCapabilityAssuranceRecord",
      "required": ["temporal_scope"],
      "properties": {
        "assurance_class": {
          "$ref": "vocabularies/assurance-v1.schema.json#/$defs/contractualCapabilityClass"
        },
        "temporal_scope": { "$ref": "#/$defs/contractualCapabilityTemporalScope" },
        "conditions": { "$ref": "#/$defs/conditions" }
      }
    }
  ],
  "$defs": {
    "openvaSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "dateOrNull": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "framework": {
      "type": "object",
      "required": ["framework_id"],
      "properties": {
        "framework_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\.-]*$",
          "minLength": 1
        },
        "framework_version": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["entity_name", "scope_description"],
      "properties": {
        "entity_id": {
          "anyOf": [
            { "$ref": "#/$defs/openvaSlug" },
            { "type": "null" }
          ]
        },
        "entity_name": { "$ref": "#/$defs/nonEmptyString" },
        "scope_description": { "$ref": "#/$defs/nonEmptyString" },
        "products_or_services": { "$ref": "#/$defs/uniqueStrings" },
        "locations": { "$ref": "#/$defs/uniqueStrings" }
      },
      "additionalProperties": false
    },
    "issuer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "authority_type": {
          "enum": [
            "certification_body",
            "audit_firm",
            "regulator",
            "vendor",
            "other"
          ]
        },
        "accreditation_body": { "type": ["string", "null"] },
        "country": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "certificate_number": { "type": ["string", "null"] },
        "report_identifier": { "type": ["string", "null"] },
        "assessment_identifier": { "type": ["string", "null"] },
        "registration_identifier": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "accreditedCertificationIdentifiers": {
      "allOf": [
        { "$ref": "#/$defs/identifiers" },
        {
          "anyOf": [
            {
              "required": ["certificate_number"],
              "properties": { "certificate_number": { "$ref": "#/$defs/nonEmptyString" } }
            },
            {
              "required": ["report_identifier"],
              "properties": { "report_identifier": { "$ref": "#/$defs/nonEmptyString" } }
            },
            {
              "required": ["assessment_identifier"],
              "properties": { "assessment_identifier": { "$ref": "#/$defs/nonEmptyString" } }
            },
            {
              "required": ["registration_identifier"],
              "properties": { "registration_identifier": { "$ref": "#/$defs/nonEmptyString" } }
            }
          ]
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["source_ids"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/openvaSlug" }
        },
        "primary_source_id": {
          "anyOf": [
            { "$ref": "#/$defs/openvaSlug" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "certificationTemporalScope": {
      "title": "certificationTemporalScope",
      "type": "object",
      "required": ["valid_from", "valid_until"],
      "properties": {
        "issued_at": { "type": "string", "format": "date" },
        "valid_from": { "type": "string", "format": "date" },
        "valid_until": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "reportingPeriod": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "attestationTemporalScope": {
      "title": "attestationTemporalScope",
      "type": "object",
      "properties": {
        "issued_at": { "type": "string", "format": "date" },
        "as_of_date": { "type": "string", "format": "date" },
        "reporting_period": { "$ref": "#/$defs/reportingPeriod" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["as_of_date"],
          "not": { "required": ["reporting_period"] }
        },
        {
          "required": ["reporting_period"],
          "not": { "required": ["as_of_date"] }
        }
      ]
    },
    "regulatoryAssertionTemporalScope": {
      "title": "regulatoryAssertionTemporalScope",
      "type": "object",
      "properties": {
        "claimed_as_of": { "$ref": "#/$defs/dateOrNull" },
        "effective_from_claimed": { "$ref": "#/$defs/dateOrNull" }
      },
      "additionalProperties": false
    },
    "contractualCapabilityTemporalScope": {
      "title": "contractualCapabilityTemporalScope",
      "type": "object",
      "properties": {
        "effective_from_claimed": { "$ref": "#/$defs/dateOrNull" },
        "effective_until_claimed": { "$ref": "#/$defs/dateOrNull" }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  }
}
